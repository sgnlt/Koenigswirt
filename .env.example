# Takeaway orders via Resend (https://resend.com).
# Server-only: never prefix these with NEXT_PUBLIC_.

# Resend API key (e.g. re_xxxxxxxxx).
RESEND_API_KEY=

# Recipient of takeaway order notifications.
ADMIN_EMAIL=

# Optional sender address. Defaults to "Königswirt Bestellung <onboarding@resend.dev>" if left empty.
# Once your domain is verified in Resend, you can set e.g. "Königswirt <bestellung@koenigswirt.de>".
ORDER_FROM_EMAIL=
