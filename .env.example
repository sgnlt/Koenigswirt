# Takeaway orders. Server-only: never prefix these with NEXT_PUBLIC_.

# Recipient of order emails. Changing it needs no code change.
ADMIN_EMAIL=
# Sender address. Its domain must be verified with the SMTP provider (SPF/DKIM).
ORDER_FROM_EMAIL=

SMTP_HOST=
# 465 uses implicit TLS; other ports (usually 587) upgrade with STARTTLS.
SMTP_PORT=587
# Leave both empty only if the server accepts unauthenticated mail.
SMTP_USER=
SMTP_PASS=
